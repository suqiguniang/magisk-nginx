# ===========================================================================
# HTTPS 示例：监听 443(需 allow-low-ports)，使用模块自带的自签证书。
#
# 启用方法：
#   1. 重命名本文件为 01-https.conf
#   2. 如需 443 低端口：touch /data/nginx/allow-low-ports (重启后生效)
#   3. 「执行」菜单选「重启 nginx」
#
# 自带证书是「测试用自签证书」(CN=nginx-for-android, 有效期10年)，
# 浏览器会报不受信任 —— 局域网测试没问题；生产环境请换成正式证书：
#   把 /data/nginx/conf/ssl/ 下换成你的 .crt/.key 并改下面两行路径。
# ===========================================================================

server {
    listen        443 ssl;
    # listen        [::]:443 ssl;
    server_name   _;

    ssl_certificate     /data/nginx/conf/ssl/selfsigned.crt;
    ssl_certificate_key /data/nginx/conf/ssl/selfsigned.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;

    # HTTPS 页面：代理到你的本机服务
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # WebSocket
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # 证书信息自检页(可选)
    location /nginx_status {
        stub_status;
        allow 127.0.0.1;
        deny all;
    }
}
